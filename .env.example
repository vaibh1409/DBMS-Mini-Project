# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL connection (the Docker container from the README listens on 5433)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=herdsense

# The app's own login, created by db/logic/roles_grants.sql.
# DB_PASSWORD is the app_password you chose when running that script.
DB_USER=herdsense_app
DB_PASSWORD=

# Secret used to sign login tokens (JWT): any random text, at least 32 characters
JWT_SECRET=
