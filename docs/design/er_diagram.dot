digraph ER {
  rankdir=TB; nodesep=0.9; ranksep=1.3; pad=0.4;
  graph [fontname="Helvetica", label="HerdSense ER Diagram (crow's foot notation)", labelloc=t, fontsize=20];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=10, dir=both, color="#444444"];
  Farm_Staff [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#cfe8ff"><B>Farm_Staff</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">staff_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">SERIAL</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">full_name</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>UK</B></TD><TD ALIGN="LEFT">username</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">TIMESTAMP</FONT></TD></TR></TABLE>>];
  Cattle [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#cfe8ff"><B>Cattle</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">cattle_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">SERIAL</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>UK</B></TD><TD ALIGN="LEFT">tag_number</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">breed</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">sex</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">CHAR(1)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">date_of_birth</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(10)</FONT></TD></TR></TABLE>>];
  Breeding_Records [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#cfe8ff"><B>Breeding_Records</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">breeding_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">SERIAL</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">dam_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">sire_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">breeding_date</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">method</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">outcome</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK,UK</B></TD><TD ALIGN="LEFT">calf_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">recorded_by</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR></TABLE>>];
  Health_Records [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#cfe8ff"><B>Health_Records</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">health_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">SERIAL</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">cattle_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">vet_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">record_date</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">vet_notes</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">suspected_condition</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">treatment</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">TEXT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">severity</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(10)</FONT></TD></TR></TABLE>>];
  Vaccinations [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#cfe8ff"><B>Vaccinations</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">vaccination_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">SERIAL</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">cattle_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">vaccine_name</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">administered_date</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">interval_days</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">next_due_date</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">administered_by</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR></TABLE>>];
  Milk_Yield [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#cfe8ff"><B>Milk_Yield</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">yield_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">SERIAL</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">cattle_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">yield_date</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">session</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(10)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">litres</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">NUMERIC(5,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">recorded_by</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR></TABLE>>];
  Note_Embeddings [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD COLSPAN="3" BGCOLOR="#ffe3b3"><B>Note_Embeddings</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">embedding_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">SERIAL</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK,UK</B></TD><TD ALIGN="LEFT">health_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">cattle_id</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">INT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">note_date</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">suspected_condition</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">embedding</TD><TD ALIGN="LEFT"><FONT COLOR="#666666">vector(384)</FONT></TD></TR></TABLE>>];
  Farm_Staff -> Health_Records [label="examines\n(vet_id)", arrowtail=teetee, arrowhead=crowodot];
  Farm_Staff -> Vaccinations [label="administers\n(administered_by)", arrowtail=teetee, arrowhead=crowodot];
  Farm_Staff -> Milk_Yield [label="records\n(recorded_by)", arrowtail=teetee, arrowhead=crowodot];
  Farm_Staff -> Breeding_Records [label="records\n(recorded_by)", arrowtail=teetee, arrowhead=crowodot];
  Cattle -> Health_Records [label="has\n(cattle_id)", arrowtail=teetee, arrowhead=crowodot];
  Cattle -> Vaccinations [label="receives\n(cattle_id)", arrowtail=teetee, arrowhead=crowodot];
  Cattle -> Milk_Yield [label="produces\n(cattle_id)", arrowtail=teetee, arrowhead=crowodot];
  Cattle -> Breeding_Records [label="dam of\n(dam_id)", arrowtail=teetee, arrowhead=crowodot];
  Cattle -> Breeding_Records [label="sire of\n(sire_id)", arrowtail=teetee, arrowhead=crowodot];
  Cattle -> Breeding_Records [label="born as (calf)\n(calf_id)", arrowtail=teetee, arrowhead=teeodot];
  Health_Records -> Note_Embeddings [label="embedded as\n(health_id)", arrowtail=teetee, arrowhead=teeodot];
}